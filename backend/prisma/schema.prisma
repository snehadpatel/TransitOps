datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  password_hash   String
  role            String    // FLEET_MANAGER | DISPATCHER | SAFETY_OFFICER | FINANCIAL_ANALYST
  failed_attempts Int       @default(0)
  locked_until    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
}

model Vehicle {
  id                  String   @id @default(uuid())
  registration_number String   @unique
  name_model          String
  type                String   @default("OTHER") // VAN | TRUCK | BUS | MOTORCYCLE | OTHER
  max_load_capacity   Float    // kg
  odometer            Float    @default(0) // km
  acquisition_cost    Float
  status              String   @default("AVAILABLE") // AVAILABLE | ON_TRIP | IN_SHOP | RETIRED
  region              String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  trips               Trip[]
  maintenance_logs    MaintenanceLog[]
  fuel_logs           FuelLog[]
  expenses            Expense[]
  documents           Document[]

  @@index([status])
  @@index([type])
  @@index([region])
}

model Driver {
  id                String       @id @default(uuid())
  name              String
  license_number    String       @unique
  license_category  String
  license_expiry    DateTime
  contact_number    String?
  safety_score      Float        @default(100)
  trip_completions  Int          @default(0)  // count of COMPLETED trips
  status            String       @default("AVAILABLE") // AVAILABLE | ON_TRIP | OFF_DUTY | SUSPENDED
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt

  trips Trip[]

  @@index([status])
}

model Trip {
  id               String    @id @default(uuid())
  trip_code        String    @unique
  source           String
  destination      String
  vehicle_id       String
  vehicle          Vehicle   @relation(fields: [vehicle_id], references: [id])
  driver_id        String
  driver           Driver    @relation(fields: [driver_id], references: [id])
  cargo_weight     Float     // kg
  planned_distance Float     // km
  status           String    @default("DRAFT") // DRAFT | DISPATCHED | COMPLETED | CANCELLED
  eta              DateTime?
  final_odometer   Float?    // km — set on completion
  fuel_consumed    Float?    // liters — set on completion
  started_at       DateTime?
  completed_at     DateTime?
  cancelled_at     DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  fuel_logs FuelLog[]
  expenses  Expense[]

  @@index([status])
  @@index([vehicle_id])
  @@index([driver_id])
}

model MaintenanceLog {
  id           String    @id @default(uuid())
  vehicle_id   String
  vehicle      Vehicle   @relation(fields: [vehicle_id], references: [id])
  service_type String
  cost         Float
  date         DateTime  @default(now())
  status       String    @default("ACTIVE") // ACTIVE | CLOSED
  notes        String?
  closed_at    DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([vehicle_id])
  @@index([status])
}

model FuelLog {
  id         String   @id @default(uuid())
  vehicle_id String
  vehicle    Vehicle  @relation(fields: [vehicle_id], references: [id])
  trip_id    String?
  trip       Trip?    @relation(fields: [trip_id], references: [id])
  date       DateTime @default(now())
  liters     Float
  cost       Float
  created_at DateTime @default(now())

  @@index([vehicle_id])
  @@index([trip_id])
}

model Expense {
  id         String   @id @default(uuid())
  vehicle_id String
  vehicle    Vehicle  @relation(fields: [vehicle_id], references: [id])
  trip_id    String?
  trip       Trip?    @relation(fields: [trip_id], references: [id])
  toll       Float    @default(0)
  other      Float    @default(0)
  total      Float    // toll + other
  category   String?
  date       DateTime @default(now())
  notes      String?
  created_at DateTime @default(now())

  @@index([vehicle_id])
  @@index([trip_id])
}

model Setting {
  id            String   @id @default("global")
  depot_name    String   @default("TransitOps Depot")
  currency      String   @default("INR")
  distance_unit String   @default("km")
  updated_at    DateTime @updatedAt
}

model Document {
  id         String   @id @default(uuid())
  vehicle_id String
  vehicle    Vehicle  @relation(fields: [vehicle_id], references: [id])
  url        String
  name       String
  uploaded_at DateTime @default(now())

  @@index([vehicle_id])
}
